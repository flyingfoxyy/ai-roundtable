# Table 参与者名册【默认模板】：每个 [[participants]] 段 = 一个 AI。
# 增删 AI = 增删段落；调整调用方式改 cmd（argv 数组，prompt 走 stdin，回复取 stdout）。
# 段落顺序 = 发言与轮值主编顺序（第一个参与者负责合成 v1）。
#
# 本文件是随代码分发的默认模板，圆桌会议在没有自定义名册时直接使用它。
# 要自定义：复制为 table.toml 再编辑（table.toml 已被 .gitignore 忽略，属于你的本地配置）。
#   cp table.toml.bak table.toml

[[participants]]
name = "Claude"
cmd = ["claude", "-p"]
lens = "重点审查：可维护性与长期复杂度"
timeout = 300

[[participants]]
name = "Gemini"
cmd = ["gemini"]
lens = "重点审查：性能、扩展性与运维负担"
timeout = 300

[[participants]]
name = "Codex"
cmd = ["codex", "exec", "--skip-git-repo-check", "-"]
lens = "重点审查：工程落地成本与迁移风险"
timeout = 300
